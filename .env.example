# ── Google Gemini API ──────────────────────────────────────────────────────────
# Obtener en: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# ── Picovoice (Wake Word "Jarvis") ─────────────────────────────────────────────
# Obtener en: https://console.picovoice.ai/ (plan gratuito disponible)
PICOVOICE_KEY=your_picovoice_key_here

# ── Telegram Bot (Gateway móvil) ───────────────────────────────────────────────
# Crear bot con @BotFather en Telegram y copiar el token aquí
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# Tu ID numérico de Telegram (no el username). Obtenerlo enviando /start al bot
# la primera vez que lo inicies — lo imprime en la consola.
TELEGRAM_ALLOWED_ID=your_telegram_numeric_id_here

# ── Micrófono (Windows DirectShow) ────────────────────────────────────────────
# Nombre exacto de tu dispositivo de micrófono en Windows.
# Para encontrarlo, correr en terminal: ffmpeg -list_devices true -f dshow -i dummy
# Ejemplo en español: Micrófono (Realtek High Definition Audio)
# Ejemplo en inglés:  Microphone (Realtek High Definition Audio)
MIC_DEVICE=Micrófono (Realtek High Definition Audio)

# ── Firebase (La Garra — nodo local) ──────────────────────────────────────────
# Descargar de: Firebase Console → Configuración del proyecto → Cuentas de servicio
# → Generar nueva clave privada → guardar como serviceAccount.json en la raíz
# NUNCA subir serviceAccount.json al repositorio
FIREBASE_SERVICE_ACCOUNT=./serviceAccount.json
